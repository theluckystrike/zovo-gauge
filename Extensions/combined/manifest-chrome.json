{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDesc__",
  "default_locale": "en",
  "version": "__RYD_VERSION__",
  "manifest_version": 3,
  "background": {
    "service_worker": "zgq-worker.js"
  },
  "icons": {
    "16": "icons/icon-gauge16.png",
    "48": "icons/icon-gauge48.png",
    "128": "icons/icon-gauge128.png"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://zgubxqomnbmxgbdhvwja.supabase.co/*"
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "zgq-panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://*.music.youtube.com/*"
      ],
      "js": [
        "zgq-observer.js"
      ],
      "css": [
        "zgq-surface.css"
      ]
    }
  ],
  "options_ui": {
    "page": "zgq-panel.html",
    "open_in_tab": false
  }
}
